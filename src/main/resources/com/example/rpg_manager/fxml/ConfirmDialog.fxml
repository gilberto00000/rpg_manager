<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.rpg_manager.ConfirmDialogController"
           styleClass="confirm-dialog-root">

    <VBox prefWidth="460"
          spacing="20"
          styleClass="confirm-dialog">

        <Label fx:id="tituloLabel"
               text="Confirmação"
               styleClass="confirm-dialog-title"/>

        <Label fx:id="mensagemLabel"
               text="Deseja continuar?"
               wrapText="true"
               styleClass="confirm-dialog-message"/>

        <HBox alignment="CENTER_RIGHT"
              spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Cancelar"
                    onAction="#cancelar"
                    styleClass="confirm-dialog-cancel"/>

            <Button fx:id="confirmarBtn"
                    text="Confirmar"
                    onAction="#confirmar"
                    styleClass="confirm-dialog-confirm"/>

        </HBox>

    </VBox>

    <stylesheets>
        <URL value="@../style/confirm-dialog.css"/>
    </stylesheets>

</StackPane>