<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620"
            prefWidth="900"
            styleClass="ficha-cenario-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rpg_manager.FichaCenarioController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="cenario-top-bar">

            <Button fx:id="voltarBtn"
                    onAction="#voltar"
                    text="Fechar"
                    styleClass="secondary-button"/>

            <Label text="Cenário"
                   styleClass="cenario-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="salvarBtn"
                    onAction="#salvar"
                    text="Salvar cenário"
                    styleClass="primary-button"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="22"
              styleClass="cenario-content">

            <VBox spacing="8">
                <Label text="Nome do cenário"
                       styleClass="field-label"/>

                <TextField fx:id="nomeField"
                           promptText="Ex: Floresta abandonada"/>
            </VBox>

            <VBox spacing="10">

                <Label text="Imagem"
                       styleClass="field-label"/>

                <StackPane styleClass="cenario-preview-container">

                    <ImageView fx:id="imagemPreview"
                               fitWidth="640"
                               fitHeight="360"
                               preserveRatio="true"
                               smooth="true"/>

                </StackPane>

                <Button onAction="#escolherImagem"
                        text="Escolher imagem"
                        styleClass="primary-button"/>

            </VBox>

        </VBox>
    </center>

    <stylesheets>
        <URL value="@../style/app.css"/>
        <URL value="@../style/ficha-cenario.css"/>
    </stylesheets>

</BorderPane>