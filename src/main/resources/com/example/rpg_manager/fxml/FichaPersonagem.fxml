<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ProgressBar?>
<BorderPane prefHeight="768" prefWidth="1366" styleClass="root" stylesheets="@../style/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rpg_manager.FichaPersonagemController">

    <top>

        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">

            <Button text="← Voltar"
                    onAction="#voltar"
                    styleClass="primary-button"/>

            <Label styleClass="titulo" text="Ficha do Personagem" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="salvarBtn"
                    text="Salvar Personagem"
                    onAction="#salvar"
                    styleClass="primary-button"/>

        </HBox>

    </top>

    <center>

        <TabPane fx:id="tabPane">

            <Tab text="Básico">
                <HBox spacing="40" styleClass="content-area">

                    <VBox spacing="15" alignment="TOP_CENTER">

                        <ImageView fx:id="avatarPreview"
                                   fitWidth="180"
                                   fitHeight="220"
                                   preserveRatio="true"/>

                        <Button text="Escolher Avatar"
                                onAction="#escolherAvatar"
                                styleClass="primary-button"
                                prefWidth="180"/>

                    </VBox>

                    <VBox spacing="18" prefWidth="450">

                        <Label text="Nome do personagem"/>
                        <TextField fx:id="nomeField"
                                   promptText="Digite o nome do personagem"/>

                        <Label text="Classe"/>
                        <ComboBox fx:id="classeCombo"/>

                        <Label text="NEX (%)"/>
                        <Spinner fx:id="nexSpinner"/>

                    </VBox>

                </HBox>
            </Tab>

            <Tab text="Atributos">
                <VBox spacing="20" styleClass="content-area">

                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label text="Pontos disponíveis:"/>

                        <TextField fx:id="pontosDisponiveisField"
                                   prefWidth="80"/>

                        <Button text="Aplicar"
                                onAction="#aplicarPontosDisponiveis"
                                styleClass="primary-button"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Pontos restantes:"/>

                        <Label fx:id="pontosRestantesLabel"
                               text="10"
                               styleClass="card-title"/>

                    </HBox>

                    <VBox fx:id="atributosContainer" spacing="12"/>

                </VBox>
            </Tab>

            <Tab text="Status">
                <content>
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                styleClass="status-scroll">

                        <VBox spacing="22"
                              styleClass="status-page">

                            <Label text="Recursos atuais"
                                   styleClass="section-title"/>

                            <GridPane hgap="18"
                                      vgap="16"
                                      styleClass="status-grid">

                                <VBox spacing="10"
                                      styleClass="resource-card"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Vida"
                                               styleClass="resource-title"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="vidaLabel"
                                               text="0 / 0"
                                               styleClass="resource-value"/>
                                    </HBox>

                                    <ProgressBar fx:id="vidaProgress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="vida-progress"/>

                                    <HBox alignment="CENTER"
                                          spacing="12">

                                        <Button text="−"
                                                onAction="#diminuirVida"
                                                styleClass="status-minus-button"/>

                                        <Button text="+"
                                                onAction="#aumentarVida"
                                                styleClass="status-plus-button"/>
                                    </HBox>

                                </VBox>

                                <VBox spacing="10"
                                      styleClass="resource-card"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="PE"
                                               styleClass="resource-title"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="peLabel"
                                               text="0 / 0"
                                               styleClass="resource-value"/>
                                    </HBox>

                                    <ProgressBar fx:id="peProgress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="pe-progress"/>

                                    <HBox alignment="CENTER"
                                          spacing="12">

                                        <Button text="−"
                                                onAction="#diminuirPe"
                                                styleClass="status-minus-button"/>

                                        <Button text="+"
                                                onAction="#aumentarPe"
                                                styleClass="status-plus-button"/>
                                    </HBox>

                                </VBox>

                                <VBox spacing="10"
                                      styleClass="resource-card"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="0">

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Sanidade"
                                               styleClass="resource-title"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="sanidadeLabel"
                                               text="0 / 0"
                                               styleClass="resource-value"/>
                                    </HBox>

                                    <ProgressBar fx:id="sanidadeProgress"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="sanidade-progress"/>

                                    <HBox alignment="CENTER"
                                          spacing="12">

                                        <Button text="−"
                                                onAction="#diminuirSanidade"
                                                styleClass="status-minus-button"/>

                                        <Button text="+"
                                                onAction="#aumentarSanidade"
                                                styleClass="status-plus-button"/>
                                    </HBox>

                                </VBox>

                                <VBox spacing="10"
                                      styleClass="danger-status-card"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">

                                    <Label text="Rodadas em morrendo"
                                           styleClass="resource-title"/>

                                    <Label fx:id="rodadasMorrendoLabel"
                                           text="0 / 3"
                                           styleClass="danger-value"/>

                                    <HBox alignment="CENTER"
                                          spacing="12">

                                        <Button text="−"
                                                onAction="#diminuirRodadasMorrendo"
                                                styleClass="status-minus-button"/>

                                        <Button text="+"
                                                onAction="#aumentarRodadasMorrendo"
                                                styleClass="danger-plus-button"/>
                                    </HBox>

                                </VBox>
                            </GridPane>

                            <Separator styleClass="status-separator"/>

                            <Label text="Status calculados"
                                   styleClass="section-title"/>

                            <GridPane hgap="18"
                                      vgap="16"
                                      styleClass="status-grid">

                                <VBox spacing="6"
                                      styleClass="calculated-card"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">

                                    <Label text="Defesa"
                                           styleClass="status-name"/>
                                    <Label fx:id="defesaLabel"
                                           text="0"
                                           styleClass="calculated-value"/>
                                </VBox>

                                <VBox spacing="6"
                                      styleClass="calculated-card"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">

                                    <Label text="Esquiva"
                                           styleClass="status-name"/>
                                    <Label fx:id="esquivaLabel"
                                           text="0"
                                           styleClass="calculated-value"/>
                                </VBox>

                                <VBox spacing="6"
                                      styleClass="calculated-card"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="0">

                                    <Label text="Bloqueio"
                                           styleClass="status-name"/>
                                    <Label fx:id="bloqueioLabel"
                                           text="0"
                                           styleClass="calculated-value"/>
                                </VBox>

                                <VBox spacing="6"
                                      styleClass="calculated-card"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">

                                    <Label text="Deslocamento"
                                           styleClass="status-name"/>
                                    <Label fx:id="deslocamentoLabel"
                                           text="0 m"
                                           styleClass="calculated-value"/>
                                </VBox>

                                <VBox spacing="6"
                                      styleClass="calculated-card"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">

                                    <Label text="Limite de PE/turno"
                                           styleClass="status-name"/>
                                    <Label fx:id="limitePeLabel"
                                           text="0"
                                           styleClass="calculated-value"/>
                                </VBox>

                            </GridPane>

                        </VBox>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab text="Perícias">

                <AnchorPane fx:id="periciasPane" />

            </Tab>

            <Tab text="Equipamentos">

                <AnchorPane fx:id="equipamentosPane" />

            </Tab>

            <Tab text="Habilidades">

                <AnchorPane fx:id="habilidadesPane" />

            </Tab>

        </TabPane>

    </center>

</BorderPane>
