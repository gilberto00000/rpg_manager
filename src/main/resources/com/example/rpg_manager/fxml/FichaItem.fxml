<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600"
            prefWidth="850"
            styleClass="ficha-item-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rpg_manager.FichaItemController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="item-top-bar">

            <Button fx:id="voltarBtn"
                    onAction="#voltar"
                    styleClass="secondary-button"
                    text="Fechar"/>

            <Label text="Ficha do Item"
                   styleClass="item-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="salvarBtn"
                    onAction="#salvar"
                    styleClass="primary-button"
                    text="Salvar Item"/>

        </HBox>
    </top>

    <center>
        <HBox spacing="35"
              styleClass="item-content">

            <VBox alignment="TOP_CENTER"
                  spacing="15">

                <ImageView fx:id="avatarPreview"
                           fitHeight="220"
                           fitWidth="180"
                           preserveRatio="true"/>

                <Button onAction="#escolherAvatar"
                        prefWidth="180"
                        styleClass="primary-button"
                        text="Escolher imagem"/>

            </VBox>

            <VBox spacing="14"
                  prefWidth="500">

                <Label text="Nome do item"
                       styleClass="field-label"/>

                <TextField fx:id="nomeField"
                           promptText="Digite o nome do item"/>

                <Label text="Descrição"
                       styleClass="field-label"/>

                <TextArea fx:id="descricaoField"
                          promptText="Descreva o item"
                          wrapText="true"
                          prefHeight="260"/>

            </VBox>

        </HBox>
    </center>

    <stylesheets>
        <URL value="@../style/app.css"/>
        <URL value="@../style/ficha-item.css"/>
    </stylesheets>

</BorderPane>