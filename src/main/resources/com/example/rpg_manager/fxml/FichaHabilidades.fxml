<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768" prefWidth="1366" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rpg_manager.FichaHabilidadesController">

    <top>

        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">

            <Button fx:id="voltarBtn" onAction="#voltar" styleClass="primary-button" text="← Voltar" />

            <Label styleClass="titulo" text="Ficha da Habilidade" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="salvarBtn" onAction="#salvar" styleClass="primary-button" text="Salvar Habilidade" />

        </HBox>

    </top>

    <center>

        <HBox spacing="40" styleClass="content-area">

            <VBox alignment="TOP_CENTER" spacing="15">

                <ImageView fx:id="avatarPreview" fitHeight="220" fitWidth="180" preserveRatio="true" />

                <Button onAction="#escolherAvatar" prefWidth="180" styleClass="primary-button" text="Escolher Avatar" />

            </VBox>

            <VBox prefWidth="450" spacing="18">

                <Label text="Nome da habilidade" />
                <TextField fx:id="nomeField" promptText="Digite o nome da habilidade" />

                <Label text="Descrição" />
                <TextArea fx:id="descricaoField"
                          prefHeight="180"
                          prefWidth="450"
                          wrapText="true"
                          promptText="Descreva a habilidade..."
                          styleClass="custom-text-area"/>

            </VBox>

        </HBox>


    </center>
    <stylesheets>
        <URL value="@../style/app.css" />
        <URL value="@../style/ficha-personagem.css" />
    </stylesheets>

</BorderPane>
