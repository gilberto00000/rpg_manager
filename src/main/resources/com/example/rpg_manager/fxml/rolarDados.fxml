<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768"
            prefWidth="1366"
            styleClass="dice-page"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rpg_manager.DiceRollController">

    <center>

        <VBox alignment="CENTER"
              spacing="22"
              styleClass="dice-content">


            <!-- =========================================
                 HISTÓRICO DAS ROLAGENS
            ========================================== -->

            <Label fx:id="detalhesRolagem"
                   text=""
                   wrapText="true"
                   styleClass="dice-details"/>


            <!-- =========================================
                 RESULTADO TOTAL
            ========================================== -->

            <Label fx:id="resultRolar"
                   text="0"
                   styleClass="dice-total"/>


            <!-- =========================================
                 MODIFICADOR
            ========================================== -->

            <VBox alignment="CENTER"
                  spacing="8">

                <Label text="Modificador"
                       styleClass="modifier-title"/>

                <HBox alignment="CENTER"
                      spacing="45">

                    <Button text="−"
                            onAction="#diminuirModificador"
                            styleClass="dice-main-action"/>

                    <Label fx:id="modificadorLabel"
                           text="0"
                           styleClass="modifier-value"/>

                    <Button text="+"
                            onAction="#aumentarModificador"
                            styleClass="dice-main-action"/>

                </HBox>

            </VBox>


            <!-- =========================================
                 RESET
            ========================================== -->

            <Button text="↻"
                    onAction="#limparRolagem"
                    styleClass="reset-button"/>


            <Region prefHeight="10"/>


            <!-- =========================================
                 DADOS
            ========================================== -->

            <GridPane alignment="CENTER"
                      hgap="30"
                      vgap="30"
                      styleClass="dice-grid">


                <!-- D2 -->
                <StackPane GridPane.columnIndex="0"
                           GridPane.rowIndex="0">

                    <Button id="2"
                            text="2"
                            onAction="#rolarDado"
                            styleClass="dice-button, d2-button"/>

                </StackPane>


                <!-- D4 -->
                <StackPane GridPane.columnIndex="1"
                           GridPane.rowIndex="0">

                    <Button id="4"
                            text="4"
                            onAction="#rolarDado"
                            styleClass="dice-button, d4-button"/>

                </StackPane>


                <!-- D6 -->
                <StackPane GridPane.columnIndex="2"
                           GridPane.rowIndex="0">

                    <Button id="6"
                            text="6"
                            onAction="#rolarDado"
                            styleClass="dice-button, d6-button"/>

                </StackPane>


                <!-- D8 -->
                <StackPane GridPane.columnIndex="3"
                           GridPane.rowIndex="0">

                    <Button id="8"
                            text="8"
                            onAction="#rolarDado"
                            styleClass="dice-button, d8-button"/>

                </StackPane>


                <!-- D10 -->
                <StackPane GridPane.columnIndex="0"
                           GridPane.rowIndex="1">

                    <Button id="10"
                            text="10"
                            onAction="#rolarDado"
                            styleClass="dice-button, d10-button"/>

                </StackPane>


                <!-- D12 -->
                <StackPane GridPane.columnIndex="1"
                           GridPane.rowIndex="1">

                    <Button id="12"
                            text="12"
                            onAction="#rolarDado"
                            styleClass="dice-button, d12-button"/>

                </StackPane>


                <!-- D20 -->
                <StackPane GridPane.columnIndex="2"
                           GridPane.rowIndex="1">

                    <Button id="20"
                            text="20"
                            onAction="#rolarDado"
                            styleClass="dice-button, d20-button"/>

                </StackPane>


                <!-- D100 -->
                <StackPane GridPane.columnIndex="3"
                           GridPane.rowIndex="1">

                    <Button id="100"
                            text="100"
                            onAction="#rolarDado"
                            styleClass="dice-button, d100-button"/>

                </StackPane>

            </GridPane>

        </VBox>

    </center>


    <stylesheets>
        <URL value="@../style/diceRoll.css"/>
    </stylesheets>

</BorderPane>