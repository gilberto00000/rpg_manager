<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="resultRoll"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="600.0"
            prefWidth="1024.0"
            styleClass="dice-page"
            stylesheets="@../style/diceRoll.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rpg_manager.DiceRollController">

    <children>

        <VBox alignment="TOP_CENTER"
              spacing="28.0"
              AnchorPane.bottomAnchor="32.0"
              AnchorPane.leftAnchor="45.0"
              AnchorPane.rightAnchor="45.0"
              AnchorPane.topAnchor="32.0">

            <children>

                <!-- Cabeçalho -->
                <VBox alignment="CENTER" spacing="7.0">
                    <children>
                        <Label styleClass="dice-title"
                               text="Rolagem de Dados" />

                        <Label styleClass="dice-subtitle"
                               text="Escolha o dado que deseja rolar" />
                    </children>
                </VBox>

                <!-- Resultado -->
                <StackPane prefHeight="155.0"
                           maxWidth="430.0"
                           styleClass="result-card">

                    <children>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label styleClass="result-caption"
                                       text="RESULTADO" />

                                <Label fx:id="resultRolar"
                                       alignment="CENTER"
                                       maxWidth="Infinity"
                                       styleClass="result-number"
                                       text="—" />
                            </children>
                        </VBox>

                    </children>
                </StackPane>

                <Region prefHeight="2.0" />

                <!-- Dados -->
                <GridPane alignment="CENTER"
                          hgap="24.0"
                          vgap="24.0"
                          styleClass="dice-grid">

                    <children>

                        <Button id="2"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="2" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="4"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="4" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="6"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="6" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="8"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="3"
                                GridPane.rowIndex="0">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="8" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="10"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="10" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="12"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="12" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="20"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="1">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="20" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                        <Button id="100"
                                mnemonicParsing="false"
                                onAction="#rolarDado"
                                styleClass="dice-button"
                                GridPane.columnIndex="3"
                                GridPane.rowIndex="1">

                            <graphic>
                                <VBox alignment="CENTER" spacing="3.0">
                                    <children>
                                        <Label styleClass="dice-prefix"
                                               text="D" />
                                        <Label styleClass="dice-value"
                                               text="100" />
                                    </children>
                                </VBox>
                            </graphic>

                        </Button>

                    </children>

                    <padding>
                        <Insets top="5.0"
                                right="5.0"
                                bottom="5.0"
                                left="5.0" />
                    </padding>

                </GridPane>

                <HBox alignment="CENTER">
                    <children>
                        <Label styleClass="dice-hint"
                               text="Clique em um dado para realizar a rolagem" />
                    </children>
                </HBox>

            </children>

        </VBox>

    </children>
</AnchorPane>