<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" spacing="15" styleClass="attribute-control" stylesheets="@../style/atributo-control.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rpg_manager.AtributoControlController">

    <padding>
        <Insets bottom="8" left="12" right="12" top="8" />
    </padding>

    <Label fx:id="nomeLabel" styleClass="attribute-name" text="Agilidade" />

    <Region HBox.hgrow="ALWAYS" />

    <Button fx:id="menosBtn" onAction="#diminuir" styleClass="attribute-button" text="-" />

    <Label fx:id="valorLabel" styleClass="attribute-value" text="0" />

    <Button fx:id="maisBtn" onAction="#aumentar" styleClass="attribute-button" text="+" />

</HBox>
