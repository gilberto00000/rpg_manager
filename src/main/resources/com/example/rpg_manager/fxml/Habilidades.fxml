<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="personagens-page" stylesheets="@../style/telaPersonagens.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rpg_manager.HabilidadesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="personagens-header">

            <VBox spacing="7">
                <Label styleClass="personagens-title" text="Habilidades" />

                <Label styleClass="personagens-subtitle" text="Gerencie as fichas da campanha" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#novaHabilidade" styleClass="create-character-button" text="+  Criar habilidade" />

        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="personagens-scroll">

            <GridPane fx:id="gridHabilidades" hgap="20" styleClass="personagens-grid" vgap="20">

                <padding>
                    <Insets bottom="24" left="24" right="24" top="24" />
                </padding>

            </GridPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="12" styleClass="pagination-bar">

            <Label fx:id="paginationInfoLabel" styleClass="pagination-info" text="0 personagens" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="previousPageButton" onAction="#paginaAnterior" styleClass="pagination-arrow" text="‹" />

            <HBox fx:id="pageButtonsContainer" alignment="CENTER" spacing="8" />

            <Button fx:id="nextPageButton" onAction="#proximaPagina" styleClass="pagination-arrow" text="›" />
        </HBox>
    </bottom>

</BorderPane>
