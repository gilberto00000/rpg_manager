<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360"
      spacing="12"
      styleClass="cenario-card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rpg_manager.CenarioCardController">

    <StackPane styleClass="cenario-image-container">

        <ImageView fx:id="cenarioImage"
                   fitWidth="328"
                   fitHeight="184.5"
                   preserveRatio="true"
                   smooth="true"/>

    </StackPane>

    <Label fx:id="nomeLabel"
           text="Nome do cenário"
           styleClass="cenario-card-title"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER"
          spacing="10">

        <Button fx:id="exibirBtn"
                text="Exibir"
                onAction="#exibir"
                styleClass="cenario-display-button"/>

        <Button fx:id="editarBtn"
                text="Editar"
                onAction="#editar"
                styleClass="cenario-edit-button"/>

        <Button fx:id="excluirBtn"
                text="Excluir"
                onAction="#excluir"
                styleClass="cenario-delete-button"/>

    </HBox>

    <stylesheets>
        <URL value="@../style/cenario-card.css"/>
    </stylesheets>

</VBox>